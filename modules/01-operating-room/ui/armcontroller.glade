<?xml version="1.0" encoding="UTF-8"?>
<!-- RTI Connext DDS — Arm Controller UI (redesigned) -->
<interface>
  <requires lib="gtk+" version="3.24"/>
  <object class="GtkApplicationWindow" id="window">
    <property name="visible">True</property>
    <property name="can-focus">False</property>
    <property name="title">Arm Controller  —  RTI Connext</property>
    <property name="default-width">720</property>
    <property name="default-height">760</property>
    <style><class name="main-window"/></style>
    <child>
      <!-- Root vertical box -->
      <object class="GtkBox">
        <property name="visible">True</property>
        <property name="orientation">vertical</property>
        <property name="spacing">0</property>

        <!-- ══════════════════════ HEADER BAR ══════════════════════ -->
        <child>
          <object class="GtkBox" id="header_bar">
            <property name="visible">True</property>
            <property name="orientation">horizontal</property>
            <property name="spacing">10</property>
            <property name="margin-start">12</property>
            <property name="margin-end">12</property>
            <property name="height-request">80</property>
            <style><class name="header-bar"/></style>
            <child>
              <object class="GtkLabel">
                <property name="visible">True</property>
                <property name="label">RTI Connext</property>
                <style><class name="header-brand"/></style>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="visible">True</property>
                <property name="label"> | </property>
                <style><class name="header-sep"/></style>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="visible">True</property>
                <property name="label">Arm Controller</property>
                <style><class name="header-title"/></style>
              </object>
            </child>
            <child>
              <object class="GtkBox">
                <property name="visible">True</property>
                <property name="hexpand">True</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="visible">True</property>
                <property name="label">● Command QoS</property>
                <style><class name="header-qos"/></style>
              </object>
            </child>
          </object>
        </child>

        <child>
          <object class="GtkFrame" id="teleop_frame">
            <property name="visible">True</property>
            <property name="label">TELEOPERATION  ·  END-EFFECTOR JOG</property>
            <property name="margin-start">12</property>
            <property name="margin-end">12</property>
            <property name="margin-top">10</property>
            <property name="margin-bottom">6</property>
            <style><class name="teleop-frame"/></style>
            <child>
              <object class="GtkBox">
                <property name="visible">True</property>
                <property name="orientation">horizontal</property>
                <property name="spacing">20</property>
                <property name="margin-start">18</property>
                <property name="margin-end">18</property>
                <property name="margin-top">14</property>
                <property name="margin-bottom">14</property>
                <child>
                  <object class="GtkBox">
                    <property name="visible">True</property>
                    <property name="orientation">vertical</property>
                    <property name="spacing">8</property>
                    <property name="hexpand">True</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="visible">True</property>
                        <property name="label">MASTER HAND CONTROL</property>
                        <property name="xalign">0</property>
                        <style><class name="teleop-title"/></style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="visible">True</property>
                        <property name="label">Hold a direction to jog the simulated tool tip; release to stop.</property>
                        <property name="xalign">0</property>
                        <property name="wrap">True</property>
                        <style><class name="teleop-copy"/></style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="visible">True</property>
                        <property name="label">X/Y uses a simplified planar two-link model. Wrist roll and gripper are separate controls.</property>
                        <property name="xalign">0</property>
                        <property name="wrap">True</property>
                        <style><class name="teleop-note"/></style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="visible">True</property>
                        <property name="label">SIMULATION ONLY  ·  NOT FOR CLINICAL USE</property>
                        <property name="xalign">0</property>
                        <style><class name="sim-warning"/></style>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkGrid" id="jog_pad">
                    <property name="visible">True</property>
                    <property name="row-spacing">6</property>
                    <property name="column-spacing">6</property>
                    <property name="column-homogeneous">True</property>
                    <property name="row-homogeneous">True</property>
                    <child>
                      <object class="GtkButton" id="y_positive">
                        <property name="visible">True</property>
                        <property name="label">▲  Y+</property>
                        <property name="width-request">110</property>
                        <property name="height-request">58</property>
                        <style><class name="btn-jog"/></style>
                      </object>
                      <packing>
                        <property name="left-attach">1</property>
                        <property name="top-attach">0</property>
                      </packing>
                    </child>
                    <child>
                      <object class="GtkButton" id="x_negative">
                        <property name="visible">True</property>
                        <property name="label">◀  X−</property>
                        <property name="width-request">110</property>
                        <property name="height-request">58</property>
                        <style><class name="btn-jog"/></style>
                      </object>
                      <packing>
                        <property name="left-attach">0</property>
                        <property name="top-attach">1</property>
                      </packing>
                    </child>
                    <child>
                      <object class="GtkButton" id="x_positive">
                        <property name="visible">True</property>
                        <property name="label">X+  ▶</property>
                        <property name="width-request">110</property>
                        <property name="height-request">58</property>
                        <style><class name="btn-jog"/></style>
                      </object>
                      <packing>
                        <property name="left-attach">2</property>
                        <property name="top-attach">1</property>
                      </packing>
                    </child>
                    <child>
                      <object class="GtkButton" id="y_negative">
                        <property name="visible">True</property>
                        <property name="label">▼  Y−</property>
                        <property name="width-request">110</property>
                        <property name="height-request">58</property>
                        <style><class name="btn-jog"/></style>
                      </object>
                      <packing>
                        <property name="left-attach">1</property>
                        <property name="top-attach">2</property>
                      </packing>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkSeparator">
                    <property name="visible">True</property>
                    <property name="orientation">vertical</property>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="visible">True</property>
                    <property name="orientation">vertical</property>
                    <property name="spacing">8</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="visible">True</property>
                        <property name="label">TOOL CONTROLS</property>
                        <property name="xalign">0</property>
                        <style><class name="teleop-title"/></style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="roll_left">
                        <property name="visible">True</property>
                        <property name="label">↶  ROLL LEFT</property>
                        <property name="height-request">48</property>
                        <style><class name="btn-tool"/></style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="roll_right">
                        <property name="visible">True</property>
                        <property name="label">↷  ROLL RIGHT</property>
                        <property name="height-request">48</property>
                        <style><class name="btn-tool"/></style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="gripper_open">
                        <property name="visible">True</property>
                        <property name="label">OPEN GRIPPER</property>
                        <property name="height-request">48</property>
                        <style><class name="btn-tool"/></style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="gripper_close">
                        <property name="visible">True</property>
                        <property name="label">CLOSE GRIPPER</property>
                        <property name="height-request">48</property>
                        <style><class name="btn-tool"/></style>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>

        <!-- ════════════════ ACTION BAR ════════════════════════════ -->
        <child>
          <object class="GtkBox">
            <property name="visible">True</property>
            <property name="orientation">horizontal</property>
            <property name="spacing">12</property>
            <property name="margin-start">8</property>
            <property name="margin-end">8</property>
            <property name="margin-top">5</property>
            <property name="margin-bottom">5</property>
            <property name="height-request">44</property>
            <style><class name="action-bar"/></style>
            <child>
              <object class="GtkBox">
                <property name="visible">True</property>
                <property name="hexpand">True</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="run_demo">
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="label">▶  RUN DEMO</property>
                <property name="width-request">170</property>
                <style><class name="btn-run-demo"/></style>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="stop_motion">
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="label">■  STOP MOTION</property>
                <property name="width-request">170</property>
                <style><class name="btn-stop-motion"/></style>
              </object>
            </child>
          </object>
        </child>

        <!-- ════════════════ ALERTS CONSOLE ════════════════════════ -->
        <child>
          <object class="GtkBox">
            <property name="visible">True</property>
            <property name="orientation">vertical</property>
            <property name="vexpand">True</property>
            <property name="spacing">4</property>
            <property name="margin-start">8</property>
            <property name="margin-end">8</property>
            <property name="margin-bottom">12</property>
            <child>
              <object class="GtkLabel">
                <property name="visible">True</property>
                <property name="label">ALERTS</property>
                <property name="xalign">0</property>
                <style><class name="console-header"/></style>
              </object>
            </child>
            <child>
              <object class="GtkScrolledWindow">
                <property name="visible">True</property>
                <property name="vexpand">True</property>
                <property name="height-request">140</property>
                <style><class name="console-scroll"/></style>
                <child>
                  <object class="GtkTextView" id="console">
                    <property name="visible">True</property>
                    <property name="can-focus">True</property>
                    <property name="editable">False</property>
                    <property name="wrap-mode">word</property>
                    <property name="left-margin">8</property>
                    <property name="right-margin">8</property>
                    <property name="top-margin">6</property>
                    <property name="bottom-margin">6</property>
                    <style><class name="console-text"/></style>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>

      </object>
    </child>
  </object>
</interface>
