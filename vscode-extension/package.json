{
  "name": "medtech-web-tabs",
  "displayName": "MedTech Web Tabs",
  "description": "Opens MedTech demo web UIs in VS Code editor tabs.",
  "version": "0.1.0",
  "publisher": "rti",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onUri",
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [{ "command": "rti.medtech.openOrchestrator", "title": "Digital Operating Room: Open Orchestrator" }],
    "viewsContainers": {
      "activitybar": [{ "id": "medtech-tutorial", "title": "Digital Operating Room", "icon": "tutorial.svg" }]
    },
    "views": {
      "medtech-tutorial": [{ "id": "rti.medtechTutorial", "name": "Tutorial", "type": "webview" }]
    }
  },
  "main": "./extension.js"
}