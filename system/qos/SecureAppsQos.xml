<dds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://community.rti.com/schema/7.7.0/rti_dds_profiles.xsd" version="7.7.0">

  <configuration_variables>
    <value>
      <element>
        <!-- Path to generated runtime security artifacts.
              This path is relative to the "current working directory" when
              running the application (i.e. from the `modules` folder).
              It can be overridden by setting the RTI_SECURITY_ARTIFACTS_DIR
              environment variable.
        -->
        <name>RTI_SECURITY_ARTIFACTS_DIR</name>
        <value>../../system/security/artifacts</value>
      </element>
      <element>
        <name>RTI_SECURITY_DEPLOYMENT_NAME</name>
        <value>local</value>
      </element>
      <element>
        <name>RTI_SECURITY_LAN_DOMAIN_DIR</name>
        <value>0</value>
      </element>
      <element>
        <name>RTI_SECURITY_LAN_DOMAIN_TAG</name>
        <value></value>
      </element>
      <element>
        <name>RTI_SECURITY_LAN_BASE</name>
        <value>CommonSecurityConfig</value>
      </element>
      <element>
        <name>RTI_SECURITY_WAN_DOMAIN_DIR</name>
        <value>1</value>
      </element>
      <element>
        <name>RTI_SECURITY_WAN_DOMAIN_TAG</name>
        <value></value>
      </element>
      <element>
        <name>RTI_SECURITY_WAN_BASE</name>
        <value>CommonSecurityConfig</value>
      </element>
    </value>
  </configuration_variables>

  <qos_library name="DPFactoryQosLib">
    <qos_profile name="Default"
        is_default_participant_factory_profile="true">
      <participant_factory_qos>
        <monitoring>
          <enable>false</enable>
        </monitoring>
      </participant_factory_qos>
    </qos_profile>
  </qos_library>

  <qos_library name="CommonLibrary">
    <qos_profile name="CommonSecurityConfig">
      <?rti-qos_snippet?>
      <domain_participant_qos>
        <base_name>
          <element>BuiltinQosSnippetLib::Feature.Security.Enable</element>
        </base_name>
        <property>
          <value>
            <!-- Enable distributed secure logging for these modules -->
            <element>
              <name>com.rti.serv.secure.logging.mode_mask</name>
              <value>SECURITY_TOPIC</value>
            </element>
            <!-- Set secure logging verbosity to WARNING -->
            <element>
              <name>com.rti.serv.secure.logging.verbosity</name>
              <value>WARNING</value>
            </element>
            <!-- Set secure logging topic QoS profile -->
            <!-- <element>
              <name>com.rti.serv.secure.logging.security_topic.profile</name>
              <value>CommonLibrary::SecurityTopicConfig</value>
            </element> -->
          </value>
        </property>
      </domain_participant_qos>
    </qos_profile>

    <qos_profile name="ManagedLanSecurityConfig" base_name="CommonSecurityConfig">
      <?rti-qos_snippet?>
      <domain_participant_qos>
        <property>
          <value>
            <element>
              <name>dds.domain_participant.domain_tag</name>
              <value>$(RTI_SECURITY_LAN_DOMAIN_TAG)</value>
            </element>
            <element>
              <name>dds.sec.auth.crl</name>
              <value>file:$(RTI_SECURITY_ARTIFACTS_DIR)/$(RTI_SECURITY_LAN_DOMAIN_DIR)/crl.pem</value>
            </element>
            <element>
              <name>dds.sec.crypto.rtps_psk_secret_passphrase_extra</name>
              <value>file:$(RTI_SECURITY_ARTIFACTS_DIR)/$(RTI_SECURITY_LAN_DOMAIN_DIR)/psk_secret_extra.key</value>
            </element>
          </value>
        </property>
      </domain_participant_qos>
    </qos_profile>

    <!-- LAN participants use domain ID 0, optionally with a provisioned domain tag. -->
    <qos_profile name="LanCommonSecurityConfig" base_name="$(RTI_SECURITY_LAN_BASE)">
      <?rti-qos_snippet?>
      <domain_participant_qos>
        <property>
          <value>
            <element>
              <name>dds.sec.access.permissions_ca</name>
              <value>file:$(RTI_SECURITY_ARTIFACTS_DIR)/$(RTI_SECURITY_LAN_DOMAIN_DIR)/permissions_ca.crt</value>
            </element>
            <element>
              <name>dds.sec.auth.identity_ca</name>
              <value>file:$(RTI_SECURITY_ARTIFACTS_DIR)/$(RTI_SECURITY_LAN_DOMAIN_DIR)/identity_ca.crt</value>
            </element>
            <element>
              <name>dds.sec.access.governance</name>
              <value>file:$(RTI_SECURITY_ARTIFACTS_DIR)/$(RTI_SECURITY_LAN_DOMAIN_DIR)/governance.p7s</value>
            </element>
            <element>
              <name>dds.sec.crypto.rtps_psk_secret_passphrase</name>
              <value>file:$(RTI_SECURITY_ARTIFACTS_DIR)/$(RTI_SECURITY_LAN_DOMAIN_DIR)/psk_secret.key</value>
            </element>
          </value>
        </property>
      </domain_participant_qos>
    </qos_profile>

    <!-- "Remote" (WAN) connections for these modules are only on Domain 1. -->
    <qos_profile name="ManagedWanSecurityConfig" base_name="CommonSecurityConfig">
      <?rti-qos_snippet?>
      <domain_participant_qos>
        <property>
          <value>
            <element>
              <name>dds.domain_participant.domain_tag</name>
              <value>$(RTI_SECURITY_WAN_DOMAIN_TAG)</value>
            </element>
            <element>
              <name>dds.sec.auth.crl</name>
              <value>file:$(RTI_SECURITY_ARTIFACTS_DIR)/$(RTI_SECURITY_WAN_DOMAIN_DIR)/crl.pem</value>
            </element>
            <element>
              <name>dds.sec.crypto.rtps_psk_secret_passphrase_extra</name>
              <value>file:$(RTI_SECURITY_ARTIFACTS_DIR)/$(RTI_SECURITY_WAN_DOMAIN_DIR)/psk_secret_extra.key</value>
            </element>
          </value>
        </property>
      </domain_participant_qos>
    </qos_profile>

    <qos_profile name="WanCommonSecurityConfig" base_name="$(RTI_SECURITY_WAN_BASE)">
      <?rti-qos_snippet?>
      <domain_participant_qos>
        <property>
          <value>
            <element>
              <name>dds.sec.access.permissions_ca</name>
              <value>file:$(RTI_SECURITY_ARTIFACTS_DIR)/$(RTI_SECURITY_WAN_DOMAIN_DIR)/permissions_ca.crt</value>
            </element>
            <element>
              <name>dds.sec.auth.identity_ca</name>
              <value>file:$(RTI_SECURITY_ARTIFACTS_DIR)/$(RTI_SECURITY_WAN_DOMAIN_DIR)/identity_ca.crt</value>
            </element>
            <element>
              <name>dds.sec.access.governance</name>
              <value>file:$(RTI_SECURITY_ARTIFACTS_DIR)/$(RTI_SECURITY_WAN_DOMAIN_DIR)/governance.p7s</value>
            </element>
            <!-- PSK passphrase loaded from file generated by setup_security.py.
                 For Builtin Security Plugins participants, rtps_psk_protection_kind
                 is controlled via Governance; do NOT set dds.sec.access.rtps_psk_protection_kind
                 here (that property is for Lightweight Builtin Security Plugins only). -->
            <element>
              <name>dds.sec.crypto.rtps_psk_secret_passphrase</name>
              <value>file:$(RTI_SECURITY_ARTIFACTS_DIR)/$(RTI_SECURITY_WAN_DOMAIN_DIR)/psk_secret.key</value>
            </element>
            <!-- Connext 7.6.0+: uncomment to enable zero-loss PSK rotation using
                 the decode-only extra passphrase window. Populate psk_secret_extra.key
                 with the old + new passphrases during the transition, then clear it.
                 See PskSeed docstring in security_tree.py for the full rotation sequence. -->
            <!-- <element>
              <name>dds.sec.crypto.rtps_psk_secret_passphrase_extra</name>
              <value>file:$(RTI_SECURITY_ARTIFACTS_DIR)/$(RTI_SECURITY_WAN_DOMAIN_DIR)/psk_secret_extra.key</value>
            </element> -->
          </value>
        </property>
      </domain_participant_qos>
    </qos_profile>
  </qos_library>

