#ifndef MEDTECH_DEVICE_IDL
#define MEDTECH_DEVICE_IDL
module Device {
    const string TOPIC_COMMAND = "t/device/command";
    const string TOPIC_STATUS = "t/device/status";
    const string TOPIC_HEARTBEAT = "t/device/heartbeat";
    enum DeviceStatuses { ON, OFF, PAUSED, ERROR };
    enum DeviceType { ARM_CONTROLLER, ARM, VIDEO_PUB, VIDEO_SUB, PATIENT_MONITOR, PATIENT_SENSOR };
    enum DeviceCommands { START, SHUTDOWN, PAUSE };
    @appendable struct Status {
        @key DeviceType device;
        DeviceStatuses status;
    };
    @appendable struct Heartbeat {
        @key DeviceType device;
    };
    @appendable struct Command {
        @key DeviceType device;
        DeviceCommands command;
    };
};
#endif
