#ifndef MEDTECH_TOOL_IDL
#define MEDTECH_TOOL_IDL
module Robot {
    module Tool {
        const string TOPIC_CONTROL = "t/robot/tool/control";
        @appendable struct ParallelJawControl {
            @key string<32> arm_id;
            @unit("m/s") double opening_rate;
        };
        @nested struct ParallelJawState {
            @unit("m") double opening_width;
        };
    };
};
#endif
