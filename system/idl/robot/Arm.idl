#ifndef MEDTECH_ARM_IDL
#define MEDTECH_ARM_IDL
#include "../common/Geometry.idl"
#include "Tool.idl"
module Robot {
    module Arm {
        const string TOPIC_CONTROL = "t/robot/arm/control";
        const string TOPIC_TELEMETRY = "t/robot/arm/telemetry";
        // TCP linear/angular velocity uses the fixed, right-handed arm base frame (+Z up).
        // Angular velocity rotates about base-oriented axes through the TCP, not the base origin.
        @appendable struct TeleopControl {
            @key string<32> arm_id;
            @unit("m/s") Geometry::Vector3 linear_velocity;
            @unit("rad/s") Geometry::Vector3 angular_velocity;
        };
        @appendable struct Telemetry {
            @key string<32> arm_id;
            @optional Geometry::Pose tcp_pose;
            @optional Robot::Tool::ParallelJawState parallel_jaw;
        };
    };
};
#endif
