<dds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:noNamespaceSchemaLocation="http://community.rti.com/schema/7.7.0/rti_dds_profiles.xsd"
  version="7.7.0">
  <domain_library name="ConnextDomainLib">
    <domain name="OperationalDataDomain" domain_id="0">
      <!-- Types need to be registered once. 2 different topics can use the same type -->
      <register_type name="Robot::Arm::TeleopControl"/>
      <register_type name="Robot::Tool::ParallelJawControl"/>
      <register_type name="Robot::Arm::Status"/>
      <register_type name="Robot::Arm::Telemetry"/>
      <register_type name="Device::Status"/>
      <register_type name="Device::Heartbeat"/>
      <register_type name="Patient::Vitals"/>
      <register_type name="Device::Command"/>

      <!-- t/ stands for topic. This is just some nomenclature,
           the DDS standard does not make this mandatory. -->
      <topic name="t/robot/arm/control" register_type_ref="Robot::Arm::TeleopControl"/>
      <topic name="t/robot/tool/control" register_type_ref="Robot::Tool::ParallelJawControl"/>
      <topic name="t/robot/arm/status" register_type_ref="Robot::Arm::Status"/>
      <topic name="t/robot/arm/telemetry" register_type_ref="Robot::Arm::Telemetry"/>
      <topic name="t/device/status" register_type_ref="Device::Status"/>
      <topic name="t/device/heartbeat" register_type_ref="Device::Heartbeat"/>
      <topic name="t/device/command" register_type_ref="Device::Command"/>
      <topic name="t/patient/vitals" register_type_ref="Patient::Vitals"/>
    </domain>

    <domain name="SecureLogDomain" domain_id="0">
      <register_type name="DDSSecurity::BuiltinLoggingTypeV2" type_ref="DDSSecurity::BuiltinLoggingTypeV2"/>
      <topic name="DDS:Security:LogTopicV2" register_type_ref="DDSSecurity::BuiltinLoggingTypeV2"/>
    </domain>
  </domain_library>
</dds>
